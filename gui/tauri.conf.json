{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gongfu Studio",
  "version": "0.1.0",
  "identifier": "com.pojie.Gongfutudio",
  "build": {
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gongfu Studio",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
