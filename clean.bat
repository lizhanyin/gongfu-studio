@echo off
rem Gongfu Studio: clean all build artifacts (Windows)
rem usage: clean.bat [--deps]   --deps also removes node_modules
rem NOTE: keep this file ASCII-only; cmd.exe parses bat in ANSI codepage (GBK).
setlocal
cd /d "%~dp0"

rem actual cargo output name (lowercase s, normalized from package Gongfu-Studio)
set EXE_NAME=Gongfu-Studio.exe

echo [1/3] kill leftover process...
taskkill /IM %EXE_NAME% /F >nul 2>&1
rem wait up to ~5s for exit; a running exe locks target/ files and blocks
rem cargo clean with a confusing error
set /a KILLTRIES=0
:waitkill
tasklist /FI "IMAGENAME eq %EXE_NAME%" 2>nul | find /i "%EXE_NAME%" >nul 2>&1
if errorlevel 1 goto killed
set /a KILLTRIES+=1
if %KILLTRIES% geq 5 goto killfail
timeout /t 1 /nobreak >nul
goto waitkill
:killfail
echo.
echo *** ERROR: cannot terminate %EXE_NAME%, close it manually and retry ***
pause
exit /b 1
:killed

echo [2/3] remove build artifacts...
call cargo clean
if exist "gui\target" rmdir /s /q "gui\target"
if exist "gui\ui\dist" rmdir /s /q "gui\ui\dist"
rem wasm-pack output (not in git; regenerated by npm run build via wasm script)
if exist "gui\ui\src\wasm" rmdir /s /q "gui\ui\src\wasm"

if "%~1"=="--deps" (
    echo [2/3] --deps: remove node_modules...
    if exist "gui\ui\node_modules" rmdir /s /q "gui\ui\node_modules"
    if exist "cdp\node_modules" rmdir /s /q "cdp\node_modules"
)

echo [3/3] done.
echo next: run run.bat to rebuild from scratch.
exit /b 0
